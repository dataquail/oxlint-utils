{
  "name": "oxlint-architecture-rules",
  "version": "0.1.0-beta.1",
  "type": "module",
  "license": "MIT",
  "description": "Architecture policy as one manifest of your repository, enforced as one oxlint plugin and one CLI: import boundaries over resolved module paths, restricted export sites, what a file may export, folder taxonomy with sibling parity, declared-member allowlists, and — in the CLI — cycles, orphans and transitive reach over the whole import graph.",
  "author": "zacharyweidenbach",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "architecture",
    "lint",
    "import-boundaries",
    "hexagonal",
    "monorepo",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataquail/oxlint-utils.git",
    "directory": "packages/oxlint-architecture-rules"
  },
  "homepage": "https://dataquail.github.io/oxlint-utils",
  "bugs": {
    "url": "https://github.com/dataquail/oxlint-utils/issues"
  },
  "exports": {
    ".": {
      "types": "./build/dts/index.d.ts",
      "default": "./build/esm/index.js"
    },
    "./plugin": {
      "types": "./build/dts/adapters/oxlint/plugin.d.ts",
      "default": "./build/esm/adapters/oxlint/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./build/dts/index.d.ts",
  "bin": {
    "architecture": "./build/esm/adapters/cli/main.js"
  },
  "files": [
    "build/dts",
    "build/esm",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "clean": "rm -rf build .tsbuildinfo",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.0.0-beta.94",
    "typescript": "^5.9.3",
    "unrs-resolver": "^1.12.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.77.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "oxlint": "1.81.0"
  },
  "nx": {
    "includedScripts": []
  }
}
